{
  "dashboard": {
    "title": "Zakera - Database Performance",
    "tags": ["zakera", "database", "performance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Query Performance (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zakera_db_query_duration_seconds_bucket{operation=\"select\"}[5m]))",
            "legendFormat": "SELECT p95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(zakera_db_query_duration_seconds_bucket{operation=\"insert\"}[5m]))",
            "legendFormat": "INSERT p95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(zakera_db_query_duration_seconds_bucket{operation=\"update\"}[5m]))",
            "legendFormat": "UPDATE p95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(zakera_db_query_duration_seconds_bucket{operation=\"delete\"}[5m]))",
            "legendFormat": "DELETE p95"
          }
        ],
        "yaxes": [{"label": "Duration", "format": "s"}]
      },
      {
        "id": 2,
        "title": "Query Rate by Operation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(zakera_db_queries_total{operation=\"select\"}[5m])",
            "legendFormat": "SELECT"
          },
          {
            "expr": "rate(zakera_db_queries_total{operation=\"insert\"}[5m])",
            "legendFormat": "INSERT"
          },
          {
            "expr": "rate(zakera_db_queries_total{operation=\"update\"}[5m])",
            "legendFormat": "UPDATE"
          }
        ]
      },
      {
        "id": 3,
        "title": "Connection Pool Status",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "zakera_db_connections_active",
            "legendFormat": "Active"
          },
          {
            "expr": "zakera_db_connections_idle",
            "legendFormat": "Idle"
          },
          {
            "expr": "zakera_db_connections_overflow",
            "legendFormat": "Overflow"
          }
        ]
      },
      {
        "id": 4,
        "title": "Transaction Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "targets": [
          {
            "expr": "(rate(zakera_db_transactions_committed_total[5m]) / rate(zakera_db_transactions_total[5m])) * 100",
            "legendFormat": "Commit Rate %"
          },
          {
            "expr": "(rate(zakera_db_transactions_rolled_back_total[5m]) / rate(zakera_db_transactions_total[5m])) * 100",
            "legendFormat": "Rollback Rate %"
          }
        ],
        "yaxes": [{"format": "percent", "max": 100}]
      },
      {
        "id": 5,
        "title": "Database Size Growth",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "targets": [
          {
            "expr": "zakera_db_size_bytes",
            "legendFormat": "Database Size"
          }
        ],
        "yaxes": [{"label": "Size", "format": "bytes"}]
      },
      {
        "id": 6,
        "title": "Table Row Counts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "zakera_db_table_rows{table=\"conversations\"}",
            "legendFormat": "Conversations"
          },
          {
            "expr": "zakera_db_table_rows{table=\"messages\"}",
            "legendFormat": "Messages"
          },
          {
            "expr": "zakera_db_table_rows{table=\"users\"}",
            "legendFormat": "Users"
          }
        ]
      },
      {
        "id": 7,
        "title": "Slow Queries (>1s)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(zakera_db_query_duration_seconds_bucket{le=\"1\"}[5m]))",
            "legendFormat": "Slow Queries"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Database Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(zakera_db_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Query Cache Hit Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "(rate(zakera_db_cache_hits_total[5m]) / (rate(zakera_db_cache_hits_total[5m]) + rate(zakera_db_cache_misses_total[5m]))) * 100",
            "legendFormat": "Cache Hit Rate %"
          }
        ],
        "yaxes": [{"format": "percent", "max": 100}]
      },
      {
        "id": 10,
        "title": "Conversation Load Time (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zakera_conversation_load_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Load Time"
          }
        ],
        "yaxes": [{"label": "Duration", "format": "s"}]
      },
      {
        "id": 11,
        "title": "Message Persistence Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zakera_message_save_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Save Time"
          },
          {
            "expr": "histogram_quantile(0.50, rate(zakera_message_save_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 Save Time"
          }
        ],
        "yaxes": [{"label": "Duration", "format": "s"}]
      }
    ]
  }
}
