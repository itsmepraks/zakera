{
  "dashboard": {
    "title": "Zakera AI Chat Agent - Overview",
    "tags": ["zakera", "ai", "chat", "overview"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "System Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "zakera_health_status",
            "legendFormat": "Health Status"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"value": 1, "text": "Healthy", "color": "green"},
              {"value": 0, "text": "Unhealthy", "color": "red"}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Active Conversations",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "zakera_conversations_active_total",
            "legendFormat": "Active"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 3,
        "title": "Messages per Minute",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(zakera_messages_total[1m]) * 60",
            "legendFormat": "Messages/min"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 4,
        "title": "Average Response Time",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "rate(zakera_chat_response_duration_seconds_sum[5m]) / rate(zakera_chat_response_duration_seconds_count[5m])",
            "legendFormat": "Avg Response (s)"
          }
        ],
        "options": {
          "unit": "s",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 2, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(zakera_http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "yaxes": [
          {"label": "Requests/sec", "format": "reqps"}
        ]
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(zakera_http_requests_total{status=~\"4..|5..\"}[5m])",
            "legendFormat": "{{status}} errors"
          }
        ],
        "yaxes": [
          {"label": "Errors/sec", "format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.05], "type": "gt"},
              "query": {"params": ["A", "5m", "now"]},
              "type": "query"
            }
          ],
          "name": "High Error Rate",
          "message": "Error rate is above 5%"
        }
      },
      {
        "id": 7,
        "title": "Model Provider Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum by (provider) (zakera_model_requests_total)",
            "legendFormat": "{{provider}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Token Usage by Model",
        "type": "graph",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 12},
        "targets": [
          {
            "expr": "rate(zakera_model_tokens_total[5m])",
            "legendFormat": "{{model}} - {{provider}}"
          }
        ],
        "yaxes": [
          {"label": "Tokens/sec", "format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Database Connection Pool",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "zakera_db_connections_active",
            "legendFormat": "Active"
          },
          {
            "expr": "zakera_db_connections_idle",
            "legendFormat": "Idle"
          },
          {
            "expr": "zakera_db_pool_size",
            "legendFormat": "Pool Size"
          }
        ]
      },
      {
        "id": 10,
        "title": "Database Query Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zakera_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(zakera_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          }
        ],
        "yaxes": [
          {"label": "Duration", "format": "s"}
        ]
      },
      {
        "id": 11,
        "title": "Cost per Hour",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "rate(zakera_model_cost_total[1h])",
            "legendFormat": "{{provider}}"
          }
        ],
        "yaxes": [
          {"label": "USD/hour", "format": "currencyUSD"}
        ]
      },
      {
        "id": 12,
        "title": "Conversation Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "rate(zakera_conversations_completed_total[5m]) / rate(zakera_conversations_started_total[5m]) * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "yaxes": [
          {"label": "Percentage", "format": "percent", "max": 100}
        ]
      }
    ]
  }
}
