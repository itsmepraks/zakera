{
  "dashboard": {
    "title": "Zakera - Conversation Performance",
    "tags": ["zakera", "conversations", "performance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Conversation Creation Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(zakera_conversations_created_total[5m]) * 60",
            "legendFormat": "Conversations/min"
          }
        ],
        "yaxes": [
          {"label": "Rate", "format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Message Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(zakera_messages_total{role=\"user\"}[5m])",
            "legendFormat": "User messages"
          },
          {
            "expr": "rate(zakera_messages_total{role=\"assistant\"}[5m])",
            "legendFormat": "Assistant responses"
          }
        ]
      },
      {
        "id": 3,
        "title": "Conversation Duration Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(zakera_conversation_duration_seconds_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Messages per Conversation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zakera_conversation_messages_count_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(zakera_conversation_messages_count_bucket[5m]))",
            "legendFormat": "p50"
          }
        ]
      },
      {
        "id": 5,
        "title": "Active Users",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "zakera_active_users_total",
            "legendFormat": "Active Users"
          }
        ]
      },
      {
        "id": 6,
        "title": "Conversation Archive Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(zakera_conversations_archived_total[5m])",
            "legendFormat": "Archived/sec"
          },
          {
            "expr": "rate(zakera_conversations_deleted_total[5m])",
            "legendFormat": "Deleted/sec"
          }
        ]
      },
      {
        "id": 7,
        "title": "Message Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "(rate(zakera_messages_successful_total[5m]) / rate(zakera_messages_total[5m])) * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "yaxes": [
          {"label": "Percentage", "format": "percent", "max": 100}
        ]
      },
      {
        "id": 8,
        "title": "Top Conversations by Messages",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "topk(10, zakera_conversation_message_count)",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 9,
        "title": "Conversation Tags Distribution",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "sum by (tag) (zakera_conversations_by_tag)",
            "legendFormat": "{{tag}}"
          }
        ]
      }
    ]
  }
}
