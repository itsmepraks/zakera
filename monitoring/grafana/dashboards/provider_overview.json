{
  "dashboard": {
    "title": "Zakera - Provider Overview",
    "uid": "zakera-provider-overview",
    "tags": ["zakera", "providers", "ai"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Requests per Provider",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [{
          "expr": "rate(zakera_provider_requests_total{status='success'}[5m])",
          "legendFormat": "{{provider}} - {{model}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "title": "Success Rate by Provider",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [{
          "expr": "rate(zakera_provider_requests_total{status='success'}[5m]) / rate(zakera_provider_requests_total[5m]) * 100",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "percent", "label": "Success Rate", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "title": "Response Time (p95)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [{
          "expr": "histogram_quantile(0.95, rate(zakera_provider_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{provider}} - {{model}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "title": "Total Cost (Cumulative)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [{
          "expr": "zakera_provider_cost_total",
          "legendFormat": "{{provider}} - {{model}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "currencyUSD", "label": "Cost"},
          {"format": "short"}
        ]
      },
      {
        "title": "Active Providers",
        "type": "stat",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
        "targets": [{
          "expr": "count(zakera_provider_available == 1)",
          "refId": "A"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        }
      },
      {
        "title": "Total Requests (Last Hour)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
        "targets": [{
          "expr": "increase(zakera_provider_requests_total[1h])",
          "refId": "A"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4},
        "targets": [{
          "expr": "rate(zakera_provider_requests_total{status='error'}[5m]) / rate(zakera_provider_requests_total[5m]) * 100",
          "refId": "A"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"x": 18, "y": 16, "w": 6, "h": 4},
        "targets": [{
          "expr": "rate(zakera_provider_cache_hits_total[5m]) / (rate(zakera_provider_cache_hits_total[5m]) + rate(zakera_provider_cache_misses_total[5m])) * 100",
          "refId": "A"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      }
    ]
  }
}
