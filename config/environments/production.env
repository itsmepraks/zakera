# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# IMPORTANT: Replace all placeholder values!

APP_NAME=zakera
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Use PostgreSQL in production
DATABASE_URL=postgresql://zakera_user:CHANGE_THIS_PASSWORD@db.yourdomain.com:5432/zakera

# AI Provider Keys - REPLACE WITH YOUR KEYS
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-3-opus-20240229

GOOGLE_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_MODEL=gemini-1.5-pro

XAI_API_KEY=REPLACE_WITH_YOUR_KEY
XAI_MODEL=grok-2-latest

# CRITICAL: Generate a strong secret key
# openssl rand -hex 32
SECRET_KEY=GENERATE_A_STRONG_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring
JAEGER_AGENT_HOST=jaeger.yourdomain.com
JAEGER_AGENT_PORT=6831
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.yourdomain.com:4317
OTEL_SERVICE_NAME=zakera-prod

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

SENTRY_DSN=https://REPLACE@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
ALERT_EMAIL=ops@yourdomain.com

# Caching
REDIS_URL=redis://redis.yourdomain.com:6379/0
CACHE_TTL=3600

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws
