# ===========================================
# STAGING ENVIRONMENT CONFIGURATION
# ===========================================
# Mirrors production but with reduced resources

APP_NAME=zakera-staging
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false

CORS_ORIGINS=https://staging.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

DATABASE_URL=postgresql://staging_user:STAGING_PASSWORD@staging-db.yourdomain.com:5432/zakera_staging

# Use cheaper models for staging
OPENAI_API_KEY=sk-proj-STAGING_KEY
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

SECRET_KEY=STAGING_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=2000

JAEGER_AGENT_HOST=staging-jaeger.yourdomain.com
JAEGER_AGENT_PORT=6831
OTEL_SERVICE_NAME=zakera-staging

PROMETHEUS_ENABLED=true

SENTRY_DSN=https://STAGING@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=staging

REDIS_URL=redis://staging-redis.yourdomain.com:6379/0
CACHE_TTL=1800

NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://staging-api.yourdomain.com/ws
