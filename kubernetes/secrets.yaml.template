# Template for Kubernetes Secrets
# Copy to secrets.yaml and update with actual values
# DO NOT commit secrets.yaml to version control!

---
apiVersion: v1
kind: Secret
metadata:
  name: zakera-secrets
  namespace: zakera
type: Opaque
stringData:
  # Database
  database-url: postgresql://zakera:CHANGE_ME@zakera-postgres:5432/zakera
  
  # Application secret
  secret-key: CHANGE_ME_GENERATE_RANDOM_32_CHARS
  
  # OpenAI
  openai-api-key: sk-CHANGE_ME
  
  # Anthropic
  anthropic-api-key: sk-ant-CHANGE_ME
  
  # Google
  google-api-key: AIza-CHANGE_ME
  
  # OAuth2 - Google
  google-client-id: CHANGE_ME.apps.googleusercontent.com
  google-client-secret: CHANGE_ME
  
  # OAuth2 - GitHub
  github-client-id: CHANGE_ME
  github-client-secret: CHANGE_ME
  
  # OAuth2 - Microsoft
  microsoft-client-id: CHANGE_ME
  microsoft-client-secret: CHANGE_ME
  
  # Email (for alerts)
  smtp-username: CHANGE_ME
  smtp-password: CHANGE_ME
  
  # Slack (for alerts)
  slack-webhook-url: https://hooks.slack.com/services/CHANGE_ME
