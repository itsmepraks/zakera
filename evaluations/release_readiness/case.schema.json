{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsmepraks/zakera/evaluations/release_readiness/case.schema.json",
  "title": "Zakera release readiness evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "repository",
    "revision",
    "target",
    "proposed_claims",
    "required_source_categories",
    "constraints",
    "frozen_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "proposed_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_source_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository_files",
          "commit_history",
          "pull_requests",
          "issues",
          "ci_checks",
          "documentation",
          "release_records"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "public_repository", "external_writes"],
      "properties": {
        "read_only": {"const": true},
        "public_repository": {"const": true},
        "external_writes": {"const": false}
      }
    },
    "frozen_at": {
      "type": "string",
      "format": "date"
    }
  }
}
