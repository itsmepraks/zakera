# =============================================================================
# ZAKERA AI CHAT AGENT - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# -----------------------------------------------------------------------------
# API Keys - Model Providers
# -----------------------------------------------------------------------------

# OpenAI API Key (for GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google API Key (for Gemini models)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaYour-Google-Key-Here

# OpenRouter API Key (for unified access to 100+ models)
# Get your key from: https://openrouter.ai/keys
# OpenRouter provides access to GPT-4, Claude, Llama, Mixtral, and more through one API
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Cohere API Key (for Cohere models)
# Get your key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-key-here

# Groq API Key (for ultra-fast inference)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# Mistral API Key (for Mistral models)
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-key-here

# HuggingFace API Token (for HuggingFace models)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your-huggingface-token-here

# DeepSeek API Key (for DeepSeek models)
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Perplexity API Key (for Perplexity Sonar models with real-time search)
# Get your key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Cerebras API Key (for ultra-fast Llama inference on CS-3 wafer-scale chips)
# Supported models: llama3.1-8b, llama3.1-70b, llama3.3-70b
# Get your key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-api-key-here

# -----------------------------------------------------------------------------
# Local Model Configuration
# -----------------------------------------------------------------------------

# Ollama Base URL (for local models)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Default model to use
# Options: gpt-4-turbo, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet, 
#          gemini-1.5-pro, gemini-pro, llama3:70b, mixtral:8x7b
#          openai/gpt-4-turbo, anthropic/claude-3-opus (via OpenRouter)
DEFAULT_MODEL=gpt-3.5-turbo

# Application environment
# Options: development, production, testing
ENVIRONMENT=development

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Enable/Disable Features
ENABLE_STREAMING=true
ENABLE_TOOLS=true
ENABLE_MEMORY=true
ENABLE_VECTOR_MEMORY=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Database URL (SQLAlchemy format)
# SQLite example: sqlite:///./zakera.db
# PostgreSQL example: postgresql://user:password@localhost/zakera
DATABASE_URL=sqlite:///./zakera.db

# Database pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis Configuration (for caching)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Cache TTL (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_CONVERSATION=7200
CACHE_TTL_MODEL_RESPONSE=1800

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# JWT Secret Key (generate a strong random key)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# Token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------

# Enable monitoring features
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true

# Prometheus Metrics
METRICS_PORT=9090
METRICS_PATH=/metrics

# OpenTelemetry Tracing
# Jaeger endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=zakera-ai-agent
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/zakera.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# -----------------------------------------------------------------------------
# Alerting Configuration
# -----------------------------------------------------------------------------

# Email Alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_FROM=alerts@zakera.ai
ALERT_EMAIL_TO=admin@example.com

# Slack Alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord Alerts
ALERT_DISCORD_ENABLED=false
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# -----------------------------------------------------------------------------
# Vector Memory Configuration
# -----------------------------------------------------------------------------

# Embedding model for vector memory
# Options: sentence-transformers/all-MiniLM-L6-v2, openai, anthropic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store settings
VECTOR_STORE_TYPE=faiss
VECTOR_DIMENSION=384
VECTOR_SIMILARITY_THRESHOLD=0.7

# Memory consolidation settings
MEMORY_MAX_MESSAGES=100
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_INTERVAL=50

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------

# Worker settings
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker

# Timeout settings
REQUEST_TIMEOUT=60
KEEPALIVE_TIMEOUT=5

# Memory limits
MAX_MEMORY_MB=2048

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------

# Debug mode (DO NOT enable in production)
DEBUG=false

# Auto-reload on code changes
RELOAD=false

# Enable API documentation
ENABLE_DOCS=true
DOCS_URL=/api/docs
REDOC_URL=/api/redoc

# -----------------------------------------------------------------------------
# Testing Configuration
# -----------------------------------------------------------------------------

# Test database URL
TEST_DATABASE_URL=sqlite:///./test_zakera.db

# Test mode
TEST_MODE=false
