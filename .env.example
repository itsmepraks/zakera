# Zakera AI Chat Agent - Environment Configuration

# ======================
# AI Model Configuration
# ======================
MODEL_PROVIDER=openai  # Options: openai, anthropic, google, local
MODEL_NAME=gpt-4-turbo-preview

# API Keys (add your own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ======================
# Server Configuration
# ======================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ======================
# Database Configuration
# ======================
DATABASE_URL=sqlite:///./data/zakera.db
POSTGRES_PASSWORD=change-this-in-production

# ======================
# Cache Configuration
# ======================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-this-in-production

# ======================
# Security
# ======================
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ======================
# Features
# ======================
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60

# ======================
# Conversation Settings
# ======================
MAX_CONVERSATION_TOKENS=4000
MAX_CONVERSATION_TURNS=50
DEFAULT_TEMPERATURE=0.7

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ======================
# Tool System Configuration
# ======================
# Enable/disable tool system
ENABLE_TOOLS=true

# Tool caching
TOOL_CACHE_TTL=300  # Cache TTL in seconds (5 minutes)
ENABLE_TOOL_CACHE=true

# Tool rate limiting
ENABLE_TOOL_RATE_LIMITING=true
TOOL_MAX_RETRIES=3

# ======================
# Tool API Keys
# ======================
# Web Search Tools
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=

# Weather Tool
OPENWEATHER_API_KEY=

# Note: Some tools work without API keys (calculator, datetime, code_executor)
# To get API keys:
# - Google Custom Search: https://developers.google.com/custom-search
# - Bing Search: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
# - OpenWeatherMap: https://openweathermap.org/api
