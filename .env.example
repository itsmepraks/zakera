# =============================================================================
# Zakera AI Chat Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/zakera.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/zakera

# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# AI Model Providers - API Keys
# -----------------------------------------------------------------------------

# OpenAI (GPT-4, GPT-3.5)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
ENABLE_OPENAI=true

# Anthropic Claude (Claude 3 family)
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ENABLE_ANTHROPIC=true

# Google Gemini
# Get your key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza...
ENABLE_GEMINI=true

# Groq AI (Ultra-fast inference with LPU)
# Get your key: https://console.groq.com/
GROQ_API_KEY=gsk_...
ENABLE_GROQ=true
GROQ_DEFAULT_MODEL=llama-3.1-70b-versatile

# Mistral AI
# Get your key: https://console.mistral.ai/
MISTRAL_API_KEY=...
ENABLE_MISTRAL=false

# Cohere AI
# Get your key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...
ENABLE_COHERE=false

# -----------------------------------------------------------------------------
# Local Model Configuration
# -----------------------------------------------------------------------------

# Ollama Configuration
# Install Ollama: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_OLLAMA=true

# HuggingFace Configuration
ENABLE_HUGGINGFACE=false
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HUGGINGFACE_DEVICE=cuda  # or cpu
HUGGINGFACE_8BIT=false  # Enable 8-bit quantization
HUGGINGFACE_4BIT=false  # Enable 4-bit quantization

# -----------------------------------------------------------------------------
# Model Selection and Fallback
# -----------------------------------------------------------------------------

# Default model to use (can be from any provider)
# Examples: gpt-4-turbo, claude-3-sonnet, llama3:8b, mistral:7b, llama-3.1-70b-versatile
DEFAULT_MODEL=gpt-3.5-turbo

# Fallback strategy: none, sequential, fastest, cheapest
FALLBACK_STRATEGY=sequential

# Enable automatic fallback to alternative models
ENABLE_MODEL_FALLBACK=true

# Provider priorities (higher = tried first)
# Useful for preferring local models before API calls
PROVIDER_PRIORITY_OPENAI=10
PROVIDER_PRIORITY_ANTHROPIC=9
PROVIDER_PRIORITY_GROQ=8
PROVIDER_PRIORITY_GEMINI=7
PROVIDER_PRIORITY_OLLAMA=6
PROVIDER_PRIORITY_MISTRAL=5
PROVIDER_PRIORITY_COHERE=4
PROVIDER_PRIORITY_HUGGINGFACE=3

# -----------------------------------------------------------------------------
# Model Generation Parameters (Defaults)
# -----------------------------------------------------------------------------
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=40

# -----------------------------------------------------------------------------
# Tool System Configuration
# -----------------------------------------------------------------------------

# Enable/disable tool system
ENABLE_TOOLS=true

# Tool execution timeout (seconds)
TOOL_EXECUTION_TIMEOUT=30

# Tool caching
TOOL_CACHE_ENABLED=true
TOOL_CACHE_TTL=3600  # seconds

# Tool rate limiting
TOOL_RATE_LIMIT_ENABLED=true
TOOL_RATE_LIMIT_PER_MINUTE=60

# External API keys for tools
# Weather API: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# News API: https://newsapi.org/
NEWS_API_KEY=

# Web search: https://serpapi.com/
SERPAPI_KEY=

# -----------------------------------------------------------------------------
# Performance and Caching
# -----------------------------------------------------------------------------

# Response caching
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_TTL=1800  # seconds

# Memory management
MAX_CONVERSATION_HISTORY=50  # messages
MAX_CONTEXT_TOKENS=8000

# Request rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------

# Enable Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_FILE=logs/zakera.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=json  # json or text

# Alert configuration
ENABLE_ALERTS=true
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=
ALERT_DISCORD_ENABLED=false
ALERT_DISCORD_WEBHOOK=

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
WS_MAX_CONNECTIONS=100

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=true
ENABLE_CONVERSATION_BRANCHING=true
ENABLE_USER_PREFERENCES=true
ENABLE_EXPORT=true
ENABLE_STREAMING=true

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
ENABLE_HOT_RELOAD=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_SQL_ECHO=false

# -----------------------------------------------------------------------------
# Production Settings
# -----------------------------------------------------------------------------

# Health check intervals (seconds)
HEALTH_CHECK_INTERVAL=30
READINESS_CHECK_TIMEOUT=5
LIVENESS_CHECK_TIMEOUT=10

# Graceful shutdown
SHUTDOWN_TIMEOUT=30

# Request timeout (seconds)
REQUEST_TIMEOUT=300
