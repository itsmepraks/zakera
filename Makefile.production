# Production Makefile for Zakera
# Comprehensive commands for deployment and operations

.PHONY: help

# Colors
BLUE := \033[0;34m
GREEN := \033[0;32m
YELLOW := \033[1;33m
RED := \033[0;31m
NC := \033[0m # No Color

help: ## Show this help message
	@echo '$(BLUE)Zakera Production Operations$(NC)'
	@echo ''
	@echo 'Usage:'
	@echo '  make $(GREEN)<target>$(NC)'
	@echo ''
	@echo 'Targets:'
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# ============================================================================
# Infrastructure
# ============================================================================

.PHONY: tf-init tf-plan tf-apply tf-destroy tf-output

tf-init: ## Initialize Terraform
	@echo "$(BLUE)Initializing Terraform...$(NC)"
	cd terraform && terraform init

tf-plan: ## Plan Terraform changes
	@echo "$(BLUE)Planning infrastructure changes...$(NC)"
	cd terraform && terraform plan -out=tfplan

tf-apply: ## Apply Terraform changes
	@echo "$(BLUE)Applying infrastructure changes...$(NC)"
	cd terraform && terraform apply tfplan

tf-destroy: ## Destroy infrastructure (CAREFUL!)
	@echo "$(RED)WARNING: This will destroy all infrastructure!$(NC)"
	@read -p "Are you sure? (yes/no): " confirm && [ "$$confirm" = "yes" ]
	cd terraform && terraform destroy

tf-output: ## Show Terraform outputs
	@cd terraform && terraform output

# ============================================================================
# Kubernetes Deployment
# ============================================================================

.PHONY: k8s-deploy k8s-update k8s-rollback k8s-status k8s-logs

k8s-deploy: ## Deploy to Kubernetes
	@echo "$(BLUE)Deploying to Kubernetes...$(NC)"
	./scripts/deploy.sh production

k8s-update: ## Update Kubernetes deployment
	@echo "$(BLUE)Updating deployment...$(NC)"
	kubectl set image deployment/zakera-api zakera=zakera:latest -n zakera
	kubectl rollout status deployment/zakera-api -n zakera

k8s-rollback: ## Rollback Kubernetes deployment
	@echo "$(YELLOW)Rolling back deployment...$(NC)"
	./scripts/rollback.sh production

k8s-status: ## Show Kubernetes status
	@echo "$(BLUE)Cluster Status:$(NC)"
	@kubectl get nodes
	@echo ""
	@echo "$(BLUE)Pods:$(NC)"
	@kubectl get pods -n zakera
	@echo ""
	@echo "$(BLUE)Services:$(NC)"
	@kubectl get svc -n zakera
	@echo ""
	@echo "$(BLUE)Ingress:$(NC)"
	@kubectl get ingress -n zakera

k8s-logs: ## View application logs
	kubectl logs -f deployment/zakera-api -n zakera --tail=100

# ============================================================================
# Docker Operations
# ============================================================================

.PHONY: docker-build docker-push docker-run docker-stop

docker-build: ## Build production Docker image
	@echo "$(BLUE)Building Docker image...$(NC)"
	docker build -f Dockerfile.production -t zakera:latest .

docker-push: ## Push Docker image to registry
	@echo "$(BLUE)Pushing Docker image...$(NC)"
	docker tag zakera:latest ghcr.io/itsmepraks/zakera:latest
	docker push ghcr.io/itsmepraks/zakera:latest

docker-run: ## Run with Docker Compose
	@echo "$(BLUE)Starting services...$(NC)"
	docker-compose -f docker-compose.production.yml up -d

docker-stop: ## Stop Docker Compose services
	@echo "$(YELLOW)Stopping services...$(NC)"
	docker-compose -f docker-compose.production.yml down

# ============================================================================
# Helm Operations
# ============================================================================

.PHONY: helm-install helm-upgrade helm-rollback helm-status

helm-install: ## Install with Helm
	@echo "$(BLUE)Installing Zakera with Helm...$(NC)"
	helm install zakera ./helm/zakera -n zakera --create-namespace

helm-upgrade: ## Upgrade Helm release
	@echo "$(BLUE)Upgrading Zakera...$(NC)"
	helm upgrade zakera ./helm/zakera -n zakera

helm-rollback: ## Rollback Helm release
	@echo "$(YELLOW)Rolling back Helm release...$(NC)"
	helm rollback zakera -n zakera

helm-status: ## Show Helm status
	helm status zakera -n zakera
	helm history zakera -n zakera

# ============================================================================
# Database Operations
# ============================================================================

.PHONY: db-migrate db-backup db-restore db-shell

db-migrate: ## Run database migrations
	@echo "$(BLUE)Running database migrations...$(NC)"
	kubectl exec -it deployment/zakera-api -n zakera -- alembic upgrade head

db-backup: ## Backup database
	@echo "$(BLUE)Creating database backup...$(NC)"
	@TIMESTAMP=$$(date +%Y%m%d_%H%M%S) && \\\n	kubectl exec -it statefulset/zakera-postgres -n zakera -- \\\n		pg_dump -U zakera zakera > backup_$$TIMESTAMP.sql && \\\n	echo "$(GREEN)Backup created: backup_$$TIMESTAMP.sql$(NC)"

db-restore: ## Restore database from backup
	@echo "$(RED)WARNING: This will overwrite the database!$(NC)"
	@read -p "Backup file: " file && \\\n	kubectl exec -i statefulset/zakera-postgres -n zakera -- \\\n		psql -U zakera zakera < $$file

db-shell: ## Connect to database
	kubectl exec -it statefulset/zakera-postgres -n zakera -- \\\n		psql -U zakera zakera

# ============================================================================
# Monitoring
# ============================================================================

.PHONY: mon-prometheus mon-grafana mon-logs mon-metrics

mon-prometheus: ## Access Prometheus
	@echo "$(BLUE)Opening Prometheus (http://localhost:9090)$(NC)"
	kubectl port-forward svc/prometheus 9090:9090 -n zakera

mon-grafana: ## Access Grafana
	@echo "$(BLUE)Opening Grafana (http://localhost:3000)$(NC)"
	kubectl port-forward svc/grafana 3000:80 -n zakera

mon-logs: ## View aggregated logs
	kubectl logs -f -l app=zakera -n zakera --tail=100

mon-metrics: ## View metrics
	@echo "$(BLUE)Fetching metrics...$(NC)"
	@kubectl exec deployment/zakera-api -n zakera -- \\\n		curl -s http://localhost:8000/api/v1/monitoring/metrics | head -50

# ============================================================================
# Scaling
# ============================================================================

.PHONY: scale-up scale-down scale-set

scale-up: ## Scale up API pods
	@echo "$(BLUE)Scaling up...$(NC)"
	kubectl scale deployment/zakera-api --replicas=5 -n zakera

scale-down: ## Scale down API pods
	@echo "$(YELLOW)Scaling down...$(NC)"
	kubectl scale deployment/zakera-api --replicas=3 -n zakera

scale-set: ## Scale to specific number
	@read -p "Number of replicas: " replicas && \\\n	kubectl scale deployment/zakera-api --replicas=$$replicas -n zakera

# ============================================================================
# Health and Diagnostics
# ============================================================================

.PHONY: health check-all diagnostics

health: ## Check application health
	@echo "$(BLUE)Checking health...$(NC)"
	@kubectl exec deployment/zakera-api -n zakera -- \\\n		curl -s http://localhost:8000/api/v1/monitoring/health | jq .

check-all: ## Run all health checks
	@echo "$(BLUE)Running comprehensive checks...$(NC)"
	@echo "1. Cluster nodes:"
	@kubectl get nodes
	@echo ""
	@echo "2. Pod health:"
	@kubectl get pods -n zakera
	@echo ""
	@echo "3. HPA status:"
	@kubectl get hpa -n zakera
	@echo ""
	@echo "4. PVC status:"
	@kubectl get pvc -n zakera
	@echo ""
	@echo "5. Application health:"
	@kubectl exec deployment/zakera-api -n zakera -- \\\n		curl -sf http://localhost:8000/api/v1/monitoring/health/ready && \\\n		echo "$(GREEN)✓ Healthy$(NC)" || echo "$(RED)✗ Unhealthy$(NC)"

diagnostics: ## Run diagnostics
	@echo "$(BLUE)Running diagnostics...$(NC)"
	@echo "Top pods by CPU:"
	@kubectl top pods -n zakera --sort-by=cpu
	@echo ""
	@echo "Top pods by memory:"
	@kubectl top pods -n zakera --sort-by=memory
	@echo ""
	@echo "Recent events:"
	@kubectl get events -n zakera --sort-by='.lastTimestamp' | tail -10

# ============================================================================
# Security
# ============================================================================

.PHONY: sec-scan sec-audit sec-rotate

sec-scan: ## Run security scan
	@echo "$(BLUE)Running security scans...$(NC)"
	docker run --rm -v $(PWD):/src aquasec/trivy fs /src
	bandit -r src/ -f json -o security-report.json

sec-audit: ## View audit logs
	@echo "$(BLUE)Recent security events:$(NC)"
	kubectl exec deployment/zakera-api -n zakera -- \\\n		curl -s http://localhost:8000/api/v1/monitoring/audit | jq .

sec-rotate: ## Rotate secrets
	@echo "$(YELLOW)Rotating secrets...$(NC)"
	@echo "1. Generate new SECRET_KEY"
	@python -c "import secrets; print(secrets.token_urlsafe(32))"
	@echo ""
	@echo "2. Update secrets.yaml with new values"
	@echo "3. Apply: kubectl apply -f kubernetes/secrets.yaml"
	@echo "4. Restart: kubectl rollout restart deployment/zakera-api -n zakera"

# ============================================================================
# Backup and Recovery
# ============================================================================

.PHONY: backup-all backup-config restore-config

backup-all: ## Backup all data
	@echo "$(BLUE)Creating comprehensive backup...$(NC)"
	@TIMESTAMP=$$(date +%Y%m%d_%H%M%S) && \\\n	mkdir -p backups/$$TIMESTAMP && \\\n	kubectl get all,configmap,secret,pvc,ingress -n zakera -o yaml > backups/$$TIMESTAMP/k8s-backup.yaml && \\\n	echo "$(GREEN)Backup created in backups/$$TIMESTAMP/$(NC)"

backup-config: ## Backup configurations
	@echo "$(BLUE)Backing up configurations...$(NC)"
	kubectl get configmap -n zakera -o yaml > backup-configmap.yaml
	@echo "$(GREEN)ConfigMaps backed up$(NC)"

restore-config: ## Restore configurations
	@echo "$(YELLOW)Restoring configurations...$(NC)"
	kubectl apply -f backup-configmap.yaml

# ============================================================================
# CI/CD
# ============================================================================

.PHONY: ci-local cd-staging cd-production

ci-local: ## Run CI checks locally
	@echo "$(BLUE)Running CI checks...$(NC)"
	black --check src/ tests/
	isort --check-only src/ tests/
	flake8 src/ tests/
	pytest tests/ -v

cd-staging: ## Deploy to staging
	@echo "$(BLUE)Deploying to staging...$(NC)"
	kubectl config use-context staging
	./scripts/deploy.sh staging

cd-production: ## Deploy to production
	@echo "$(RED)Deploying to production...$(NC)"
	@read -p "Version tag: " version && \\\n	kubectl config use-context production && \\\n	kubectl set image deployment/zakera-api zakera=zakera:$$version -n zakera && \\\n	kubectl rollout status deployment/zakera-api -n zakera

# ============================================================================
# Utilities
# ============================================================================

.PHONY: shell exec port-forward clean

shell: ## Open shell in pod
	kubectl exec -it deployment/zakera-api -n zakera -- /bin/bash

exec: ## Execute command in pod
	@read -p "Command: " cmd && \\\n	kubectl exec deployment/zakera-api -n zakera -- $$cmd

port-forward: ## Port forward to local
	@echo "$(BLUE)Port forwarding 8000:8000$(NC)"
	kubectl port-forward svc/zakera-api 8000:8000 -n zakera

clean: ## Clean local artifacts
	find . -type d -name __pycache__ -exec rm -rf {} +
	find . -type f -name "*.pyc" -delete
	rm -rf .pytest_cache htmlcov .coverage
	rm -f *.sql backup-*.yaml

# ============================================================================
# Quick Commands
# ============================================================================

.PHONY: deploy status restart logs

deploy: ## Quick deploy (production)
	@$(MAKE) k8s-deploy

status: ## Quick status check
	@$(MAKE) k8s-status

restart: ## Restart deployment
	@echo "$(BLUE)Restarting deployment...$(NC)"
	kubectl rollout restart deployment/zakera-api -n zakera

logs: ## View logs
	@$(MAKE) k8s-logs

.DEFAULT_GOAL := help
