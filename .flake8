[flake8]
# Configuration for flake8 linting

# Maximum line length
max-line-length = 100

# Maximum cyclomatic complexity
max-complexity = 10

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    .mypy_cache,
    .pytest_cache,
    node_modules,
    migrations,
    .terraform

# Error codes to ignore
ignore =
    # E203: whitespace before ':'
    E203,
    # W503: line break before binary operator
    W503,
    # E501: line too long (handled by black)
    E501,
    # F401: module imported but unused (can be valid in __init__.py)
    # W504: line break after binary operator

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811

# Show source code for errors
show-source = True

# Show relevant information
statistics = True

# Count errors
count = True

# Select error codes
select = E,W,F,C,N

# Enable naming conventions
inline-quotes = double
