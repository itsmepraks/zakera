{
  "name": "Spike Test",
  "description": "Tests system behavior during sudden traffic spikes",
  "duration": "3m",
  "users": {
    "count": 500,
    "spawn_rate": 50,
    "distribution": "spike"
  },
  "wait_time": {
    "min": 0.1,
    "max": 1.0,
    "type": "between"
  },
  "task_weights": {
    "send_message": 85,
    "list_conversations": 5,
    "get_conversation": 3,
    "export_conversation": 1,
    "list_providers": 1,
    "health_check": 5
  },
  "thresholds": {
    "p50_latency_ms": 200,
    "p95_latency_ms": 1000,
    "p99_latency_ms": 2000,
    "error_rate_percent": 10.0,
    "throughput_rps": 300,
    "recovery_time_seconds": 30
  },
  "models": [
    {"provider": "google", "model": "gemini-1.5-flash", "weight": 70},
    {"provider": "openai", "model": "gpt-3.5-turbo", "weight": 30}
  ],
  "monitoring": {
    "enable_prometheus": true,
    "prometheus_port": 8088,
    "custom_metrics": true,
    "export_reports": true,
    "sample_rate": 0.5
  },
  "spike_pattern": {
    "type": "single",
    "stages": [
      {"duration": "30s", "users": 10, "description": "baseline"},
      {"duration": "60s", "users": 500, "description": "spike"},
      {"duration": "90s", "users": 10, "description": "recovery"}
    ]
  },
  "tags": ["spike", "burst", "resilience"],
  "success_criteria": {
    "no_crashes": true,
    "system_recovers": true,
    "data_integrity_maintained": true,
    "max_downtime_seconds": 5
  }
}
