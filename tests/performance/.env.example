# Zakera Performance Testing Environment Configuration

# =============================================================================
# Target Environment
# =============================================================================

# Base API URL
BASE_URL=http://localhost:8000

# WebSocket URL
WS_URL=ws://localhost:8000

# API Version
API_VERSION=v1

# =============================================================================
# Authentication
# =============================================================================

# API Key for testing
API_KEY=test-api-key-for-performance-testing

# JWT Configuration (if using JWT auth)
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Test user credentials
TEST_USER_EMAIL=perftest@zakera.ai
TEST_USER_PASSWORD=TestPassword123!

# =============================================================================
# Model Provider API Keys (for provider testing)
# =============================================================================

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
COHERE_API_KEY=...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
HUGGINGFACE_API_KEY=hf_...

# Ollama endpoint (for local testing)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Test Configuration
# =============================================================================

# Test data directory
TEST_DATA_DIR=./test_data

# Results output directory
RESULTS_DIR=./reports

# Enable debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed HTTP logging
LOCUST_DEBUG_HTTP=false

# =============================================================================
# Locust Configuration
# =============================================================================

# Default users for tests
DEFAULT_USERS=50

# Default spawn rate (users per second)
DEFAULT_SPAWN_RATE=5

# Default run time
DEFAULT_RUN_TIME=10m

# Web UI port
WEB_PORT=8089

# Enable/disable web UI
HEADLESS=false

# =============================================================================
# Monitoring Integration
# =============================================================================

# Prometheus URL
PROMETHEUS_URL=http://localhost:9090

# Grafana URL
GRAFANA_URL=http://localhost:3001

# Jaeger URL
JAEGER_URL=http://localhost:16686

# Enable metrics push to Prometheus
PUSH_METRICS=false
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# =============================================================================
# Test Behavior Configuration
# =============================================================================

# Wait time between requests (min, max in seconds)
MIN_WAIT_TIME=1
MAX_WAIT_TIME=5

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# WebSocket message interval (seconds)
WS_MESSAGE_INTERVAL=2

# Number of messages per conversation
MESSAGES_PER_CONVERSATION=10

# Conversation length distribution (short:medium:long)
CONVERSATION_LENGTH_DIST=40:40:20

# Message complexity distribution (simple:medium:complex)
MESSAGE_COMPLEXITY_DIST=50:30:20

# =============================================================================
# Reporting Configuration
# =============================================================================

# Report format (html, csv, json, all)
REPORT_FORMAT=html

# Enable detailed per-request stats
DETAILED_STATS=true

# Enable comparison with baseline
COMPARE_BASELINE=false
BASELINE_FILE=./reports/baseline.json

# Email notification for results (optional)
EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
REPORT_EMAIL=team@zakera.ai

# Slack notification (optional)
SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# Advanced Configuration
# =============================================================================

# Connection pool size
CONNECTION_POOL_SIZE=100

# Max retries for failed requests
MAX_RETRIES=3

# Enable request compression
USE_COMPRESSION=true

# Enable keep-alive
USE_KEEPALIVE=true

# Custom headers for all requests
CUSTOM_HEADERS={}

# Tags for test run (comma-separated)
TEST_TAGS=performance,load-test,api

# Environment name (dev, staging, production)
ENVIRONMENT=staging
